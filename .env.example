# Copy to .env and fill in what you need. Every variable below has a
# working default for local dev except ONEBOX_JWT_SECRET, which you
# MUST override before deploying anywhere other than your own machine —
# see its note below.

# --- Core server ---
ONEBOX_ADDR=:8090
ONEBOX_DATA_DIR=./onebox_data
# Required for any non-local deployment. Defaults to a public, hardcoded
# dev value if unset — anyone who reads the source could forge admin
# sessions and decrypt stored provider API keys. Generate a real one, e.g.:
#   openssl rand -hex 32
ONEBOX_JWT_SECRET=dev-insecure-secret-change-me
ONEBOX_MAX_UPLOAD_SIZE=10485760
# Comma-separated allowed origins for browser requests. Defaults to "*"
# (any origin) — fine for local dev, tighten before deploying publicly.
ONEBOX_CORS_ORIGINS=*

# --- LLM chat provider (pick one) ---
# "anthropic", "openai", or "ollama"
ONEBOX_CHAT_PROVIDER=ollama
ONEBOX_CHAT_MODEL=

ONEBOX_ANTHROPIC_API_KEY=
ONEBOX_ANTHROPIC_MODEL=claude-sonnet-5

ONEBOX_OPENAI_API_KEY=
ONEBOX_OPENAI_BASE_URL=

ONEBOX_OLLAMA_BASE_URL=http://localhost:11434

# --- Embeddings (for RAG) ---
# "openai" or "ollama"
ONEBOX_EMBEDDING_PROVIDER=openai
ONEBOX_EMBEDDING_API_KEY=
ONEBOX_EMBEDDING_BASE_URL=
ONEBOX_EMBEDDING_MODEL=text-embedding-3-small

# --- Limits ---
ONEBOX_RATE_LIMIT_PER_MINUTE=20
# Per-source-IP cap on unauthenticated auth requests (login/signup/password
# reset, both user and admin) per minute — brute-force/credential-stuffing
# guard.
ONEBOX_AUTH_RATE_LIMIT_PER_MINUTE=10
ONEBOX_MONTHLY_SPEND_CAP_USD=5.0
